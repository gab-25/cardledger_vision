# Copy to .env (git-ignored) in the folder you run cardledger-vision from; real environment variables win.
CARDLEDGER_S3_BUCKET=
CARDLEDGER_S3_ACCESS_KEY_ID=
CARDLEDGER_S3_SECRET_ACCESS_KEY=
CARDLEDGER_S3_REGION=
# Only for an S3-compatible service other than AWS (e.g. R2, MinIO)
CARDLEDGER_S3_ENDPOINT=
